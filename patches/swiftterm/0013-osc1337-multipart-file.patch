+    /// PATCH 0019 (#283): one self-rescheduling main-queue check; a timer, not a lazy check,
+    /// because the unterminated case is the one where nothing else arrives.
+    func armITermMultipartWatchdog (after seconds: Double) {
+        guard !iTermMultipartWatchdogArmed else { return }
+        iTermMultipartWatchdogArmed = true
+        DispatchQueue.main.asyncAfter(deadline: .now() + seconds) { [weak self] in
+            guard let self else { return }
+            self.iTermMultipartWatchdogArmed = false
+            guard let transfer = self.iTermMultipart else { return }
+            let idle = Double(DispatchTime.now().uptimeNanoseconds - transfer.lastActivity.uptimeNanoseconds) / 1e9
+            if idle >= self.iTermMultipartInactivitySeconds {
+                self.iTermMultipart = nil
