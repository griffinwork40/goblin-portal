+    /// PATCH 0018: largest base64 payload accepted for OSC 1337 File=;inline=1.
+    /// 32 MiB encoded is ~24 MiB of image file: a full-resolution 5K PNG screenshot is
+    /// 10-20 MiB, and industry practice is a 10-50 MiB cap. Must stay below
+    /// EscapeSequenceParser.maximumOscBytes (65 MiB, already upstream) or the parser
+    /// drops it first.
+    public static let maximumInlineImageEncodedBytes = 32 * 1024 * 1024
+
+    /// PATCH 0019: one in-flight iTerm2 multipart transfer.
+    struct ITermMultipartTransfer {
+        var params: [String:String]
+        var encoded: [UInt8] = []
+        var aborted = false
+        /// Uptime of the header or the latest FilePart; the inactivity watchdog reads it.
+        var lastActivity = DispatchTime.now()
     }
+    /// PATCH 0019: nil = no transfer in flight (stray FilePart/FileEnd are ignored).
+    nonisolated(unsafe) var iTermMultipart: ITermMultipartTransfer? = nil
+    /// PATCH 0019 (#283): a transfer with no FilePart for this long is dropped and its bytes freed.
+    var iTermMultipartInactivitySeconds: Double = 120
+    nonisolated(unsafe) private var iTermMultipartWatchdogArmed = false
 
+    /// PATCH 0019 (#283): one self-rescheduling main-queue check.
+    func armITermMultipartWatchdog (after seconds: Double) {
+        guard !iTermMultipartWatchdogArmed else { return }
+        iTermMultipartWatchdogArmed = true
+        // nonisolated(unsafe): Terminal is not @MainActor but the watchdog must
+        // fire on the main queue (it writes nonisolated(unsafe) vars).  Swift 6
+        // region isolation rejects sending `self` into the closure; the unsafe
+        // local mirrors the pattern already used by iTermMultipart* vars above.
+        nonisolated(unsafe) let weakSelf: Terminal? = self
+        DispatchQueue.main.asyncAfter(deadline: .now() + seconds) {
+            guard let weakSelf else { return }
+            weakSelf.iTermMultipartWatchdogArmed = false
+            guard let transfer = weakSelf.iTermMultipart else { return }
+            let idle = Double(DispatchTime.now().uptimeNanoseconds - transfer.lastActivity.uptimeNanoseconds) / 1e9
+            if idle >= weakSelf.iTermMultipartInactivitySeconds {
+                weakSelf.iTermMultipart = nil
+            } else {
+                weakSelf.armITermMultipartWatchdog (after: weakSelf.iTermMultipartInactivitySeconds - idle)
+            }
+        }
+    }
+
+    /// PATCH 0019: dimension parser lifted out of osciTerm2 so insertInlineImage can reach it.
+    private func parseDimension (_ kv: [String:String], key: String) -> ImageSizeRequest {
+        let artificialDimensionSizeLimit = 1024*4
+        let artificialColumnLimit = 200
+        guard let v = kv [key] else { return .auto }
+        if v == "auto" { return .auto }
+        if v.hasSuffix ("%") {
+            if let n = Int (v.dropLast(1)), n > 0, n <= 100 { return .percent (n) }
+            return .auto
+        }
+        if v.hasSuffix("px") {
+            if let n = Int (v.dropLast(2)), n > 0, n < artificialDimensionSizeLimit { return .pixels (n) }
+            return .auto
+        }
+        if let n = Int (v), n > 0, n < artificialColumnLimit { return .cells(n) }
+        return .auto
+    }
+
+    /// PATCH 0019: shared decode + createImage path for single-shot File= and multipart FileEnd.
+    private func insertInlineImage (_ kv: [String:String], _ encoded: ArraySlice<UInt8>) {
+        guard let imgData = terminalBase64Decode(encoded) else {
+            return
+        }
+        let width = parseDimension (kv, key: "width")
+        let height = parseDimension (kv, key: "height")
+        tdel?.createImage(source: self, data: imgData, width: width, height: height,
+                          preserveAspectRatio: (kv ["preserveAspectRatio"] ?? "1") == "1")
+    }
