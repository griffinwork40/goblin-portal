+    /// maximumInlineImageEncodedBytes: the bytes are freed and later parts are ignored
+    /// until the next MultipartFile (or FileEnd / File= / RIS clears it).
+    struct ITermMultipartTransfer {
+        var params: [String:String]
+        var encoded: [UInt8] = []
+        var aborted = false
+        /// Uptime of the header or the latest FilePart; the inactivity watchdog reads it.
+        var lastActivity = DispatchTime.now()
