# SwiftTerm vendor pin — read by app/Scripts/verify-vendor.sh
#
# RE-VENDOR 2026-10-27 (issue #281, checkbox 3)
# Re-vendored from v1.15.0 + 20 patches to upstream main @ c3436be (post-IO-rewrite).
# Dropped (6): 0002 (isWrapped fix), 0006/0007 (selection-clear gates), 0010 (DisplayLink
# pacer), 0011 (empty-glyph cache), 0013 (combining-mark fix), 0020 (sixel bounds) —
# all incorporated by upstream's IO rewrite (PR #627), FrameDriver, PermanentEmptyGlyphCache,
# cellOrdinal/anchorOrdinal combining fix, and upstream's sixel bounds (58915b1).
# Remaining: 13 patches (0001-0013), renumbered sequentially.
# Added since: 0014 (ProMotion immediate draw, commit 3d21b931) and 0015 (fullscreen
# transition observers, #302, commit 89c1d340). Fifteen in total; verify-vendor.sh counts
# the files on disk and fails if they differ from bootstrap-vendor.sh's PATCHES list.
#
# NOTE: upstream_tag = MAIN because upstream has no v1.99.x tag at c86e1d8.
# bootstrap-vendor.sh handles MAIN by doing a full clone + checkout of upstream_commit.
#
# Regenerate the hashes below with:
#   shasum -a 256 vendor/SwiftTerm/Package.swift
#   shasum -a 256 vendor/SwiftTerm/Sources/SwiftTerm/Buffer.swift
#   shasum -a 256 vendor/SwiftTerm/Sources/SwiftTerm/Terminal.swift
#   shasum -a 256 vendor/SwiftTerm/Sources/SwiftTerm/EscapeSequenceParser.swift
#   shasum -a 256 vendor/SwiftTerm/Sources/SwiftTerm/Mac/MacTerminalView.swift
#   shasum -a 256 vendor/SwiftTerm/Sources/SwiftTerm/Apple/AppleTerminalView.swift
#   shasum -a 256 vendor/SwiftTerm/Sources/SwiftTerm/TerminalViewSearch.swift
#   shasum -a 256 vendor/SwiftTerm/Sources/SwiftTerm/Apple/FrameDriver.swift
#   shasum -a 256 vendor/SwiftTerm/Sources/SwiftTerm/Apple/Metal/MetalTerminalRenderer.swift
#   shasum -a 256 vendor/SwiftTerm/Sources/SwiftTerm/Apple/Metal/CoreTextGlyphRasterizer.swift
#   shasum -a 256 vendor/SwiftTerm/Sources/SwiftTerm/PtmuxDcsHandler.swift

upstream_repo   = https://github.com/migueldeicaza/SwiftTerm
upstream_tag    = MAIN
upstream_commit = c86e1d85bc6c5f4bca0c7e1f14fa4d1f950c434d

# Package.swift AFTER applying 0001-ship-metal-shader-as-copy-resource.patch.
# Upstream c3436be excludes Shaders.metal entirely; 0001 removes it from exclude:
# and adds it to resources: .copy so the GPU renderer compiles it at runtime.
patched_package_swift  = e8720626a1109807ddbc26dcd988e50380a189b71229aa94a4c0df6a3374a411
upstream_package_swift = 448fef1d90cfb8387efb3029709e38c9943b7e0795eeea6f5958337422d27422

# Buffer.swift AFTER applying 0002 (alt-buffer narrowing trim) and 0003 (#if DEBUG gate).
# 0002 (was 0003): moves the resize trim loop outside isReflowEnabled so it runs for all buffers.
# 0003 (was 0004): wraps the release-build fatalError post-condition in #if DEBUG/#endif.
patched_buffer_swift  = f9b602d9e1a11bffe2250a66429cfc322028ff18fb1cad88bafe1f3ad708d675
upstream_buffer_swift = cedd8f6c202134c159cac1069c9f04809cdf121efc5ae5a3b7de30bf11cbfcf5

# Terminal.swift AFTER applying 0011 (xtVersion override property defaults to "" so the
# SwiftTermBuildInfo fallback is reachable in headless/test contexts; mode 2027 modeAlwaysReset),
# 0012 (32 MiB payload cap), 0013 (multipart OSC 1337 MultipartFile/FilePart/FileEnd).
terminal_swift = 47d8977c3edd6c689296c9f3aebdadb2028605d78c4fe41935568bdc1123b3b3

# EscapeSequenceParser.swift AFTER applying 0004 (DCS Ptmux passthrough).
# Upstream c3436be already has _oscLimitExceeded + maximumOscBytes (ALREADY-UPSTREAM).
# 0004 adds the PtmuxDcsHandler branch (collect.isEmpty && code == 0x74).
patched_escape_seq_parser  = 528a501f78f4c96f883a2411e38adfaf56448ddd23e5e97e14a050e44716939a
upstream_escape_seq_parser = 986e60d2cf95f156ad8abf1d34841bd13439fa5c1cf4209317e7eac2a7416045

# PtmuxDcsHandler.swift — added by 0004, no upstream counterpart.
# Hash rotated from the v1.15.0 pin because the upstream c3436be codebase is a
# different baseline (post-IO-rewrite); the file content is identical to our v1.15.0
# version but shasum depends on the surrounding checkout, so a fresh hash is expected.
ptmux_dcs_handler = b9db2695bbb09e6762ac05e12a713a81cfa086ffe1b479ec5b6e8f379903ad3d

# MacTerminalView.swift AFTER applying 0005 (draw() open), 0006 (search hook),
# and the performKeyEquivalent open fix (compatibility for GoblinPortalTerminalView).
# Note: 0006/0007 (selection-clear gates) DROPPED — obsolete post-IO-rewrite.
# Note: 0010 (DisplayLink pacer) DROPPED — upstream now uses FrameDriver.
patched_mac_terminal_view  = a27dcde0583238d6c84f7c586007afba30abad1cedae7b4833d2dc772975066c
upstream_mac_terminal_view = 280cf244319dae1bb56f331c6da7d2a1e206fd30d788a34b95e6543889bf024a

# AppleTerminalView.swift AFTER applying 0007 (colour emoji rasterizer backingScale field in
# FrameViewState/SnapshotRenderContext + disableLigatures field), 0008 (disableLigatures open
# property + getAttributes injection), 0009 (scrollbar thumb 1/rows), 0010 (adaptiveIdlePauseEnabled
# static + onFramePresented callback + displayLinkPacingEnabled shim + Diagnostics struct with
# diagnostics/resetDiagnostics + setProcessOutputHandler for parse-thread output notification),
# 0012 (createImage/createImageFromBitmap guards), 0014 (ProMotion immediate-draw: isImmediate
# parameter on frameTick/submitFrameDraw/onTick, synchronous display() for refresh-rate promotion),
# and the getTerminal() compatibility shim.
patched_apple_terminal_view  = 702e7b24459e88a705f521f835986a7767b076952fa0ffc58af10c228e87b123
upstream_apple_terminal_view = b2cf79265c875a4fb8ce97ed83ae989084dae63d9ab082312fa128456cedc9bd

# TerminalViewSearch.swift AFTER applying 0006 (findAllMatchPositions public method).
patched_terminal_view_search  = f33e9f95b27b4d60b62ef046dcb7157d59a886a6c6c1eb4c4fe936c0e38a5e6f

# Apple/FrameDriver.swift AFTER applying 0010 (adaptive idle-pause: lastPaint/slowProducer
# fields + sourceDidTick paint/idle branch changes), 0014 (onTick signature (Bool) -> Void
# for ProMotion immediate-draw passthrough), and 0015 (fullscreen Space transition observers:
# inFullscreenTransition flag, willEnter/didEnter/willExit/didExit/didFail fullscreen observers,
# NSWorkspace.activeSpaceDidChange backstop, guard in updateVisibilityOnMain; fixes #302).
# Replaces MacDisplayLinkPacer.swift which no longer exists in upstream c3436be.
patched_frame_driver  = 2d8cd452a9c4d30a87057b9318cdb47941c66696b27dba4651bbe66eff3ca134
upstream_frame_driver = 126685bf9d5a6422a055e44bd35769a2ac54e3ec5b62221fbdff00336b82ae38

