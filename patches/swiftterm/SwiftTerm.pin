# frame setup + capturedDisableLigatures field + capture), 0008 (ShaperKey.disableLigatures
# field, shape() signature/key/attributedString, call site).
# Note: 0011 (empty-glyph cache) DROPPED — upstream PermanentEmptyGlyphCache supersedes.
# Note: 0013 (combining-mark fix) DROPPED — upstream cellOrdinal/anchorOrdinal handles this.
patched_metal_terminal_renderer  = 10c7f6ab432fdc6910a5a3b38461329be4f18e5a23cf8de1a7bbbff13901c5b1
