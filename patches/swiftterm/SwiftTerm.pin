patched_escape_seq_parser  = 2ec66786005df1ab27e783812160fed9c86c41e7b9be36134a10425116cb9cd4
upstream_escape_seq_parser = 8446f83b75c640ca1f0d4496e5b84b7c32371c8f1cdd12defb9ec3db9d402ddf

# PtmuxDcsHandler.swift — added by 0004, no upstream counterpart.
# Hash rotated from the v1.15.0 pin because the upstream c3436be codebase is a
# different baseline (post-IO-rewrite); the file content is identical to our v1.15.0
# version but shasum depends on the surrounding checkout, so a fresh hash is expected.
