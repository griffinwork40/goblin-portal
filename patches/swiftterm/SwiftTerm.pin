# SwiftTerm vendor pin — read by app/Scripts/verify-vendor.sh
#
# RE-VENDOR 2026-10-27 (issue #281, checkbox 3)
# Re-vendored from v1.15.0 + 20 patches to upstream main @ c3436be (post-IO-rewrite).
# Dropped (6): 0002 (isWrapped fix), 0006/0007 (selection-clear gates), 0010 (DisplayLink
# pacer), 0011 (empty-glyph cache), 0013 (combining-mark fix), 0020 (sixel bounds) —
# all incorporated by upstream's IO rewrite (PR #627), FrameDriver, PermanentEmptyGlyphCache,
# cellOrdinal/anchorOrdinal combining fix, and upstream's sixel bounds (58915b1).
# Remaining: 13 patches (0001-0013), renumbered sequentially.
#
# NOTE: upstream_tag = MAIN because upstream has no v1.99.x tag at c3436be.
# bootstrap-vendor.sh handles MAIN by doing a full clone + checkout of upstream_commit.
#
# Regenerate the hashes below with:
#   shasum -a 256 vendor/SwiftTerm/Package.swift
#   shasum -a 256 vendor/SwiftTerm/Sources/SwiftTerm/Buffer.swift
#   shasum -a 256 vendor/SwiftTerm/Sources/SwiftTerm/Terminal.swift
#   shasum -a 256 vendor/SwiftTerm/Sources/SwiftTerm/EscapeSequenceParser.swift
#   shasum -a 256 vendor/SwiftTerm/Sources/SwiftTerm/Mac/MacTerminalView.swift
#   shasum -a 256 vendor/SwiftTerm/Sources/SwiftTerm/Apple/AppleTerminalView.swift
#   shasum -a 256 vendor/SwiftTerm/Sources/SwiftTerm/TerminalViewSearch.swift
#   shasum -a 256 vendor/SwiftTerm/Sources/SwiftTerm/Apple/FrameDriver.swift
#   shasum -a 256 vendor/SwiftTerm/Sources/SwiftTerm/Apple/Metal/MetalTerminalRenderer.swift
#   shasum -a 256 vendor/SwiftTerm/Sources/SwiftTerm/Apple/Metal/CoreTextGlyphRasterizer.swift
#   shasum -a 256 vendor/SwiftTerm/Sources/SwiftTerm/PtmuxDcsHandler.swift

upstream_repo   = https://github.com/migueldeicaza/SwiftTerm
upstream_tag    = MAIN
upstream_commit = c3436be32e3dc26d5e2181b1e451d91e21e50d53

# Package.swift AFTER applying 0001-ship-metal-shader-as-copy-resource.patch.
# Upstream c3436be excludes Shaders.metal entirely; 0001 removes it from exclude:
# and adds it to resources: .copy so the GPU renderer compiles it at runtime.
patched_package_swift  = d95b06f75437cdfb1d92bd26ba7ce0c68258608d35dda4af10780dbe8838bc17
upstream_package_swift = 91c0b9d4a3e753c07c3175e7ef7c0cde1407172094d9ad02607cccfd5b29d18f

# Buffer.swift AFTER applying 0002 (alt-buffer narrowing trim) and 0003 (#if DEBUG gate).
# 0002 (was 0003): moves the resize trim loop outside isReflowEnabled so it runs for all buffers.
# 0003 (was 0004): wraps the release-build fatalError post-condition in #if DEBUG/#endif.
patched_buffer_swift  = 810b3773eae5caeb4bbf8b836c1c277a890eebccde64f4757f16ab7b53a3100e
upstream_buffer_swift = a573272e08909927e9ffba7579f0715d33ed002cb64c599b206b730938745e1d

# Terminal.swift AFTER applying 0011 (xtVersion + mode 2027), 0012 (32 MiB payload cap),
