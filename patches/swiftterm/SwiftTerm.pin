# handleFindBarSearchChanged, handleFindBarOptionsChanged, and hideFindBar — giving
# the host app the hook it needs for all-match search highlighting; 0010 adds the
# `displayPacer` property, re-binds it in viewDidMoveToWindow, and invalidates it in deinit.
#
# Regenerate with:
#   shasum -a 256 vendor/SwiftTerm/Sources/SwiftTerm/Mac/MacTerminalView.swift
patched_mac_terminal_view  = fda8156433639a4989c0bb5144b61a5e3d5d2c8af7a9ec9673d15cbc03fe9a6c

# MacTerminalView.swift as shipped upstream at v1.15.0.
upstream_mac_terminal_view = 2adfd7861a746d56e8e88109fea6a96f4ee7e17972dac60417864168cded4041

# AppleTerminalView.swift AFTER applying
# 0007-gate-feedprepare-selection-clear-on-mouse-mode.patch and
# 0010-pace-redraws-on-display-link.patch (0010: queuePendingDisplay and
# queueMetalDisplay try the display-link pacer before upstream's asyncAfter timer, and
# updateDisplay calls TerminalView.frameTimingObserver once per real paint).
#
# What 0007 fixes: upstream's feedPrepare() callback clears the terminal selection
# on every chunk of pty output when `allowMouseReporting` is true — which it is by
# default. This is the same defect pattern 0006 fixed in linefeed
# (MacTerminalView.swift:888): `allowMouseReporting` is a CAPABILITY flag (can this
# terminal report mouse events?) not an ACTIVE-SESSION flag (is a program actually
# tracking the mouse?). The correct check is `terminal.mouseMode != .off`.
#
# The effect: at a plain shell prompt (mouseMode == .off), ANY pty output between
# the user finishing their selection and pressing ⌘C clears selection.active, which
# causes validateUserInterfaceItem to disable Copy, silently swallowing the keystroke.
# A shell prompt redraw, a cursor position update, or any background output is enough.
#
# Severity: SILENT. A tree missing 0007 compiles, runs, and silently prevents
# copy/paste — the selection highlight may even remain visible while the underlying
# `selection.active` flag has already been cleared.
#
# Regenerate with:
#   shasum -a 256 vendor/SwiftTerm/Sources/SwiftTerm/Apple/AppleTerminalView.swift
patched_apple_terminal_view  = 1385a503a31f8d50ae59d844d9eef84348dddd5f23450cc51c1e768441e8f422

# AppleTerminalView.swift as shipped upstream at v1.15.0.
upstream_apple_terminal_view = d28360034441f9a4573debcfe8ac5f86b3c57b3059da5f94ba2549838714e45e

