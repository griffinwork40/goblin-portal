# 0020 — bound sixel parsing (#280)
#
# WHY: sixel bytes are untrusted terminal output, and upstream v1.15.0's SixelDcsHandler
# trapped on two malformed shapes BEFORE createImageFromBitmap (and 0018's side cap) ran:
#   (a) a band not closed by `$` or `-` (`ESC P q #0 ~ ESC \`, or the issue's
#       `#0;2;100;0;0 #0 !N~`): maxX was folded only on `$`/`-`, so the bitmap was sized
#       0 bytes and the second pass wrote into it — Index out of range, debug AND release.
#   (b) a repeat/colour number past Int.max (`!99999999999999999999~`): `10 * existing`
#       overflowed — arithmetic-overflow trap.
# Also unbounded: one `!N` repeat or a run of `-` sized the bitmap from input alone (a
# few bytes could ask for gigabytes before 0018's cap saw it).
# FIX: fold the open band into maxX; drop an empty image; saturate parsed numbers at
# maximumSide+1; reject (drop the whole image) once width or height would pass 8192,
# 0018's TerminalView.maximumInlineImageSide, BEFORE the bitmap is allocated.
# Colour registers, palette fields and HLS/RGB values were audited: dictionary-keyed and
# clamped already; the two passes walk identical input so the second never indexes past
# the bitmap the first sized. Every rejection is a silent drop, the parser stays in sync.
# Upstream: (a) was fixed in 58915b1 "Fix sixel crash", the commit right after the pinned
# v1.15.0 (dd2fb8a); main (c3436be) also rejects overflow and oversize
# (SixelDcsHandler.swift:90,173,262-296). This is the minimal bound on the pinned tree.
# Gate: app/Scripts/check-image-decode.sh (sixel-* cases).
--- a/Sources/SwiftTerm/SixelDcsHandler.swift
+++ b/Sources/SwiftTerm/SixelDcsHandler.swift
@@ -40,7 +40,8 @@
             
             let digit = Int(c) - 48
             if let existing = result {
-                result = 10 * existing + digit
+                // PATCH 0020: saturate instead of trapping on Int overflow (`!99999999999999999999~`).
+                result = min(10 * existing + digit, SixelDcsHandler.maximumSide + 1)
             } else {
                 result = digit
             }
@@ -78,6 +79,10 @@
     }
         
     let poundChar: UInt8 = 0x23 /* # */
+    // PATCH 0020: largest side the handler will size a bitmap for; matches 0018's
+    // TerminalView.maximumInlineImageSide. Anything larger is dropped before allocation.
+    static let maximumSide = 8192
+    var oversize = false
     
     func unhook () {
         var p = 0
@@ -86,6 +91,7 @@
         y = 0
         maxX = 0
         maxY = 0
+        oversize = false
         
         // First iteration, scan the image to compute the size
         skipToCharacter(&p, "#")
@@ -111,6 +117,11 @@
                 break
             }
         }
+        // PATCH 0020: a band not closed by `$` or `-` still has width. Upstream only folded
+        // x into maxX on `$`/`-`, so `ESC P q #0 ~ ESC \` sized a 0-byte buffer and the
+        // second pass wrote into it (Index out of range). Drop empty/oversize images.
+        maxX = max(maxX, x)
+        guard !oversize, maxX > 0, maxY > 0 else { return }
         
         // Allocate the buffer, and parse again, this time
         // plotting the data into the pixels buffer
@@ -233,6 +244,13 @@
                 x = 0
                 
             case 63...126:
+                // PATCH 0020: bound the bitmap before it is allocated; one repeat or a run
+                // of `-` could otherwise size it from untrusted input without limit.
+                guard reps <= SixelDcsHandler.maximumSide - x, y <= SixelDcsHandler.maximumSide - 6 else {
+                    oversize = true
+                    p = data.count
+                    return
+                }
                 for _ in 0..<reps {
                     write(sixel: Int(c) - 63)
                 }
