+    /// Returns the buffer-absolute positions of all matches for `term`, as an
+    /// array of `(row, col, size)` tuples - the same data `searchMatchSummary`
+    /// uses internally, but exposed so a host app can draw all-match highlights
+    /// without naming the module-internal `SearchResult` type.
+    ///
+    /// - Parameters:
+    ///   - term: The search term.
+    ///   - options: Search options (case sensitivity, regex, whole word).
+    ///   - limit: Maximum number of matches to return (default 1000).
+    /// - Returns: An array of `(row: Int, col: Int, size: Int)` in buffer-absolute
+    ///   coordinates.  `row` counts from 0 at the top of the entire display buffer
+    ///   (scrollback + screen); `col` and `size` are in buffer cells.
+    public func findAllMatchPositions (
+        _ term: String,
+        options: SearchOptions = SearchOptions(),
+        limit: Int = 1000
+    ) -> [(row: Int, col: Int, size: Int)] {
+        withTerminal { _ in
+            guard let search = search else { return [] }
+            return search.findAll(term: term, options: options, limit: limit)
+                .map { (row: $0.row, col: $0.col, size: $0.size) }
+        }
+    }
