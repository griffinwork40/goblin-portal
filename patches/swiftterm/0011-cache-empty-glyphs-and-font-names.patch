     private var glyphCache: [GlyphKey: GlyphEntry] = [:]
+    // Glyphs with zero bounding rect (the SPACE glyph and any other genuinely blank
+    // glyph). These are the only misses worth caching: CTFontGetBoundingRectsForGlyphs
+    // returning zero is deterministic for a given (font, size, glyph), so repeating the
+    // call per cell per row rebuild is pure waste (23 of 37 row-build stacks on an
+    // otherwise-idle spinner pane). Other rasterizer nil paths — empty baseAddress,
+    // CGColorSpace failure, CGContext failure — are theoretically transient and occur
+    // AFTER the bounds check passes, so they are NOT cached: a real glyph that hit one
+    // of those would stay blank until the next atlas reset (GlyphAtlas.swift:123-165).
+    // Cleared with glyphCache on atlas reset.
+    private var emptyGlyphs: Set<GlyphKey> = []
+    // PostScript name per scaled font, so glyphEntry builds its key without calling
+    // CTFontCopyPostScriptName (a CF copy + bridge) once per glyph. Keyed by identity;
+    // the font is held strongly so an ObjectIdentifier can never be reused for a
+    // different font. Both glyphEntry call sites pass a scaledFontFor result, so this
+    // holds exactly one entry per scaledFontCache entry and grows no faster than it.
+    private var fontNameCache: [ObjectIdentifier: (font: CTFont, name: String)] = [:]
     private var scaledFontCache: [GlyphKey: CTFont] = [:]
