+        // Check bounds before calling rasterize: a zero-bounds glyph is the only miss
+        // worth caching (deterministic; the space glyph always has zero bounds). Other
+        // rasterizer nil paths fire after this point and are not cached — they are
+        // theoretically transient (CGContext allocation failure), and caching them would
+        // leave a real glyph blank until the next atlas reset. One extra CoreText call
+        // per key, once. See CoreTextGlyphRasterizer.swift:8-13.
+        var glyphVar = glyph
+        let rect = CTFontGetBoundingRectsForGlyphs(font, .default, &glyphVar, nil, 1)
+        if rect.width <= 0 || rect.height <= 0 {
+            emptyGlyphs.insert(key)
+            return nil
+        }
