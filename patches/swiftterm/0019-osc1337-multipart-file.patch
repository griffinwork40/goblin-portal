+        // FileEnd"); sender: https://iterm2.com/utilities/imgcat print_image().
+        if data.elementsEqual ("FileEnd".utf8) {
+            guard let transfer = iTermMultipart else {
+                return  // stray FileEnd: nothing in flight
+            }
+            iTermMultipart = nil
+            if !transfer.aborted {
+                insertInlineImage (transfer.params, transfer.encoded[...])
+            }
+            return
+        }
