# 0019 — OSC 1337 multipart file transfer (MultipartFile / FilePart / FileEnd)
#
# WHY: iTerm2 3.5+ added a chunked form of its inline-image protocol, and modern `imgcat`
# sends it BY DEFAULT (legacy single-shot File= only with `imgcat --legacy`):
#     ESC ] 1337 ; MultipartFile=<same key=values as File=> BEL
#     ESC ] 1337 ; FilePart=<base64 chunk> BEL           (repeated; imgcat uses 200 bytes)
#     ESC ] 1337 ; FileEnd BEL
# Spec: https://iterm2.com/documentation-images.html ; sender: https://iterm2.com/utilities/imgcat
# (print_image(), `fold -w 200`). Neither vendored v1.15.0 nor upstream main handles it:
# osciTerm2 knew only "File", so every part fell through to the no-op iTermContent and
# modern imgcat showed NOTHING (.afk/research/t4.4-inline-images-research-2026-10-21.md).
#
# SHAPE (kept inside osciTerm2 + one small struct so it ports to upstream's IO rewrite #627):
#   * per-Terminal `iTermMultipart: ITermMultipartTransfer?` (params + encoded + aborted);
#   * MultipartFile starts a transfer, REPLACING any in flight; inline != 1 is not
#     buffered at all (nothing would consume a download);
#   * FilePart appends; the 0018 cap (maximumInlineImageEncodedBytes, 32 MiB) applies to
#     the CUMULATIVE encoded size — per-part it would be meaningless at 200-byte parts. On
#     exceed the bytes are freed and the rest of the transfer is ignored until the next
#     MultipartFile;
#   * FileEnd assembles and goes through insertInlineImage, the SAME helper single-shot
#     File= now uses (same width/height/preserveAspectRatio parsing, same createImage,
#     so 0018's header type/dimension checks apply unchanged);
#   * stray FilePart/FileEnd with no transfer are ignored; single-shot File= and RIS
#     (resetToInitialState) clear the state.
# Every rejection is a silent drop, as in 0018.
# Gate: app/Scripts/check-image-decode.sh (multipart cases + a captured real-imgcat
# stream, falsified by making the cap per-part and by not routing FileEnd).
--- a/Sources/SwiftTerm/Terminal.swift
+++ b/Sources/SwiftTerm/Terminal.swift
@@ -1924,6 +1924,19 @@
     /// 10-20 MiB, and industry practice is a 10-50 MiB cap. Must stay below
     /// EscapeSequenceParser.maximumOscBytes (65 MiB) or the parser drops it first.
     public static let maximumInlineImageEncodedBytes = 32 * 1024 * 1024
+
+    /// PATCH 0019: one in-flight iTerm2 multipart transfer (MultipartFile= ... FilePart=
+    /// ... FileEnd, iTerm2 3.5+, the default of modern `imgcat`). Holds the header's
+    /// key=values and the base64 parts so far. `aborted` means the cumulative encoded size
+    /// crossed maximumInlineImageEncodedBytes: the bytes are freed and later parts are
+    /// ignored until the next MultipartFile (or FileEnd / File= / RIS clears it).
+    struct ITermMultipartTransfer {
+        var params: [String:String]
+        var encoded: [UInt8] = []
+        var aborted = false
+    }
+    /// PATCH 0019: nil = no transfer in flight (stray FilePart/FileEnd are ignored).
+    var iTermMultipart: ITermMultipartTransfer? = nil
 
     func osciTerm2 (_ data: ArraySlice<UInt8>) {
         // Parses the key-value pairs separated by ";"
@@ -1969,6 +1982,36 @@
             return .auto
