+        /// PATCH 0019: the single place an inline image is decoded and handed to createImage,
+        /// shared by single-shot File= and multipart FileEnd so both get the same
+        /// width/height/preserveAspectRatio parsing and the same createImage header checks
+        /// (0018). `encoded` is the base64 payload; each CALLER enforces the 0018 encoded
+        /// cap (File= on its one payload, FilePart cumulatively) before it gets here.
+        func insertInlineImage (_ kv: [String:String], _ encoded: ArraySlice<UInt8>) {
+            guard let imgData = Data(base64Encoded: Data(encoded)) else {
+                return
+            }
+            let width = parseDimension (kv, key: "width")
