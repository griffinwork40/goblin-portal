# 0019 — OSC 1337 multipart file transfer (MultipartFile / FilePart / FileEnd)
#
# WHY: iTerm2 3.5+ added a chunked form of its inline-image protocol, and modern `imgcat`
# sends it BY DEFAULT (legacy single-shot File= only with `imgcat --legacy`):
#     ESC ] 1337 ; MultipartFile=<same key=values as File=> BEL
#     ESC ] 1337 ; FilePart=<base64 chunk> BEL           (repeated; imgcat uses 200 bytes)
#     ESC ] 1337 ; FileEnd BEL
# Spec: https://iterm2.com/documentation-images.html ; sender: https://iterm2.com/utilities/imgcat
# (print_image(), `fold -w 200`). Neither vendored v1.15.0 nor upstream main handles it:
# osciTerm2 knew only "File", so every part fell through to the no-op iTermContent and
# modern imgcat showed NOTHING (.afk/research/t4.4-inline-images-research-2026-10-21.md).
#
# SHAPE (kept inside osciTerm2 + one small struct so it ports to upstream's IO rewrite #627):
#   * per-Terminal `iTermMultipart: ITermMultipartTransfer?` (params + encoded + aborted);
#   * MultipartFile starts a transfer, REPLACING any in flight; inline != 1 is not
#     buffered at all (nothing would consume a download);
#   * FilePart appends; the 0018 cap (maximumInlineImageEncodedBytes, 32 MiB) applies to
#     the CUMULATIVE encoded size — per-part it would be meaningless at 200-byte parts. On
#     exceed the bytes are freed and the rest of the transfer is ignored until the next
#     MultipartFile;
#   * FileEnd assembles and goes through insertInlineImage, the SAME helper single-shot
#     File= now uses (same width/height/preserveAspectRatio parsing, same createImage,
#     so 0018's header type/dimension checks apply unchanged). It is a private method on
#     Terminal (#283; it was nested in osciTerm2) and takes osciTerm2's own nested
#     parseDimension as a parameter, so upstream's parser is not moved;
#   * stray FilePart/FileEnd with no transfer are ignored; single-shot File= and RIS
#     (resetToInitialState) clear the state;
#   * (#283) an UNTERMINATED transfer is dropped after iTermMultipartInactivitySeconds
#     (120 s) with no FilePart: one self-rescheduling main-queue check per transfer reads
#     a lastActivity stamp each FilePart refreshes. A timer, not a lazy check on the next
#     event, because the unterminated case is precisely the one where nothing else arrives.
# Every rejection is a silent drop, as in 0018.
# Gate: app/Scripts/check-image-decode.sh (multipart cases + a captured real-imgcat
# stream, falsified by making the cap per-part and by not routing FileEnd; #283 adds
# multipart-stale / multipart-slow-alive, falsified by never arming the watchdog and by
# FilePart not refreshing the stamp).
--- a/Sources/SwiftTerm/Terminal.swift
+++ b/Sources/SwiftTerm/Terminal.swift
@@ -1924,6 +1924,64 @@
     /// 10-20 MiB, and industry practice is a 10-50 MiB cap. Must stay below
     /// EscapeSequenceParser.maximumOscBytes (65 MiB) or the parser drops it first.
     public static let maximumInlineImageEncodedBytes = 32 * 1024 * 1024
+
+    /// PATCH 0019: one in-flight iTerm2 multipart transfer (MultipartFile= ... FilePart=
+    /// ... FileEnd, iTerm2 3.5+, the default of modern `imgcat`). Holds the header's
+    /// key=values and the base64 parts so far. `aborted` means the cumulative encoded size
+    /// crossed maximumInlineImageEncodedBytes: the bytes are freed and later parts are
+    /// ignored until the next MultipartFile (or FileEnd / File= / RIS clears it).
+    struct ITermMultipartTransfer {
+        var params: [String:String]
+        var encoded: [UInt8] = []
+        var aborted = false
+        /// Uptime of the header or the latest FilePart; the inactivity watchdog reads it.
+        var lastActivity = DispatchTime.now()
+    }
+    /// PATCH 0019: nil = no transfer in flight (stray FilePart/FileEnd are ignored).
+    var iTermMultipart: ITermMultipartTransfer? = nil
+    /// PATCH 0019 (#283): a transfer with no FilePart for this long is dropped and its bytes
+    /// freed. A `var` so a gate can shorten it; imgcat sends its parts back to back.
+    var iTermMultipartInactivitySeconds: Double = 120
+    private var iTermMultipartWatchdogArmed = false
+
+    /// PATCH 0019 (#283): WHY A TIMER and not a lazy check on the next event: an unterminated
+    /// transfer (no FileEnd/MultipartFile/File=/RIS ever follows) is exactly the case where
+    /// nothing else arrives, so a lazy check would never free the up-to-32 MiB buffer. WHY ONE
+    /// SELF-RESCHEDULING CHECK and not a timer reset per FilePart: imgcat's parts are 200 bytes,
+    /// so 32 MiB is ~168k parts; each part only stamps lastActivity and at most one check is
+    /// ever pending. Main queue, like scheduleSynchronizedOutputTimeout in this file.
+    func armITermMultipartWatchdog (after seconds: Double) {
+        guard !iTermMultipartWatchdogArmed else { return }
+        iTermMultipartWatchdogArmed = true
+        DispatchQueue.main.asyncAfter(deadline: .now() + seconds) { [weak self] in
+            guard let self else { return }
+            self.iTermMultipartWatchdogArmed = false
+            guard let transfer = self.iTermMultipart else { return }  // finished or cleared
+            let idle = Double(DispatchTime.now().uptimeNanoseconds - transfer.lastActivity.uptimeNanoseconds) / 1e9
+            if idle >= self.iTermMultipartInactivitySeconds {
+                self.iTermMultipart = nil  // stale: free the buffer
+            } else {
+                self.armITermMultipartWatchdog (after: self.iTermMultipartInactivitySeconds - idle)
+            }
+        }
+    }
+
+    /// PATCH 0019: the single place an inline image is decoded and handed to createImage,
+    /// shared by single-shot File= and multipart FileEnd so both get the same
+    /// width/height/preserveAspectRatio parsing and the same createImage header checks
+    /// (0018). `encoded` is the base64 payload; each CALLER enforces the 0018 encoded
+    /// cap (File= on its one payload, FilePart cumulatively) before it gets here.
+    /// `dimension` is osciTerm2's nested parseDimension, passed in so it stays upstream's.
+    private func insertInlineImage (_ kv: [String:String], _ encoded: ArraySlice<UInt8>,
+                                    dimension: ([String:String], String) -> ImageSizeRequest) {
+        guard let imgData = Data(base64Encoded: Data(encoded)) else {
+            return
+        }
+        let width = dimension (kv, "width")
+        let height = dimension (kv, "height")
+
+        tdel?.createImage(source: self, data: imgData, width: width, height: height, preserveAspectRatio: (kv ["preserveAspectRatio"] ?? "1" ) == "1")
+    }
 
