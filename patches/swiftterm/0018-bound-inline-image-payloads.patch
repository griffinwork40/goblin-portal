+    /// PATCH 0018: largest decoded side, in pixels, for an inline (OSC 1337) or sixel
+    /// image. 8192 matches the common decode cap (8192^2) and is above any real display
+    /// (6K = 6016 wide); at 8192x8192 RGBA a decode is 256 MiB, under kitty's 400 MiB
+    /// per-image cap (KittyGraphics.swift:145). A 60-byte PNG can claim 100000^2 in its
+    /// header, which is why this is read from the header BEFORE decoding.
+    public static let maximumInlineImageSide = 8192
+
+    /// PATCH 0018: raster types an inline image may be. An ALLOWLIST, because NSImage
+    /// (TTImage) happily decodes PDF/EPS (vector, multi-page, renders at any size) and
+    /// ImageIO knows ~20 exotic formats (EXR, PSD, KTX, ...) — each one more parser
+    /// exposed to bytes a remote host chose.
+    public static let inlineImageTypes: Set<String> = [
+        "public.png", "public.jpeg", "com.compuserve.gif", "public.tiff",
+        "com.microsoft.bmp", "public.heic", "org.webmproject.webp",
+    ]
+
     public func createImageFromBitmap(source: Terminal, bytes: inout [UInt8], width: Int, height: Int) {
+        // PATCH 0018: the sixel handler sizes `bytes` itself (SixelDcsHandler.swift:117,
+        // already allocated by the time we get here), so this bounds what is INSERTED
+        // into scrollback, and refuses a buffer that does not match the claimed size.
+        guard width > 0, height > 0, max(width, height) <= TerminalView.maximumInlineImageSide,
+              bytes.count >= width * height * 4 else {
+            return
+        }
         let rgbColorSpace = CGColorSpaceCreateDeviceRGB()
         let bitmapInfo: CGBitmapInfo = CGBitmapInfo(rawValue: CGImageAlphaInfo.premultipliedLast.rawValue)
