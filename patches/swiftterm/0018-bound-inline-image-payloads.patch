@@ -2443,6 +2466,18 @@
    
     public func createImage (source: Terminal, data: Data, width widthRequest: ImageSizeRequest, height heightRequest: ImageSizeRequest, preserveAspectRatio: Bool)
     {
+        // PATCH 0018: inspect the header (type + pixel size) through ImageIO BEFORE the
+        // full decode. CGImageSourceCopyPropertiesAtIndex reads metadata only; nothing
+        // here allocates pixels. Any failure is a silent drop — no partial insert.
+        guard let src = CGImageSourceCreateWithData(data as CFData, nil),
+              let type = CGImageSourceGetType(src) as String?,
+              TerminalView.inlineImageTypes.contains(type),
+              let props = CGImageSourceCopyPropertiesAtIndex(src, 0, nil) as? [CFString: Any],
+              let w = props[kCGImagePropertyPixelWidth] as? Int,
+              let h = props[kCGImagePropertyPixelHeight] as? Int,
+              w > 0, h > 0, max(w, h) <= TerminalView.maximumInlineImageSide else {
+            return
+        }
         guard let img = TTImage(data: data) else {
             return
         }
