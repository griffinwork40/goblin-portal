+// XtVersionDcsHandler.swift -- PATCH 0017 (T4.2 XTVERSION)
+//
+// Handles the DCS > q ST (XTVERSION) query: responds with
+//   DCS > | <xtVersion> ST
+// where xtVersion is set by the host application via Terminal.xtVersion.
+// The host app (Goblin Portal) sets this at launch from its bundle version
+// so the reply names the app, not SwiftTerm.  Vendor code cannot know the
+// app version; a sensible headless default ("GoblinPortal") is provided.
+//
+// Registered in EscapeSequenceParser.dispatchDcs for collect=[0x3e] code=0x71.
+// Follows the DECRQSS response pattern: sendResponse(cc.DCS, content, cc.ST).
+
+import Foundation
+
+final class XtVersionDcsHandler: DcsHandler {
+    weak var terminal: Terminal?
+
+    init(terminal: Terminal) {
+        self.terminal = terminal
+    }
+
+    // hook() fires when the DCS final byte is seen.
+    // DCS > q ST has no parameters or put() bytes; respond immediately.
+    func hook(collect: cstring, parameters: [Int], flag: UInt8) {
+        guard let t = terminal else { return }
+        // DCS > | <version> ST
+        let ver = t.xtVersion
+        t.sendResponse(t.cc.DCS, ">|\(ver)", t.cc.ST)
+    }
+
+    // put() receives intermediate bytes -- none expected for >q.
+    func put(data: ArraySlice<UInt8>) {}
+
+    // unhook() fires at ST -- response already sent in hook().
+    func unhook() {}
+}
