+        // extra lookup. Cache-keyed on `disableLigatures` via `resetCaches()` in the
+        // setter: toggling the flag invalidates all cached entries so the next paint
+        // rebuilds every dictionary with the new setting.
+        if disableLigatures {
+            nsattr[kCTLigatureAttributeName as NSAttributedString.Key] = 0
         }
 
