+    /// When `true`, OpenType ligature substitution is suppressed in BOTH renderers.
+    ///
+    /// Core Text path (patch 0014): `getAttributes(_:withUrl:)` adds
+    /// `kCTLigatureAttributeName: 0` to every attribute dictionary before caching.
+    /// Metal path (patch 0014): `ShaperCache` keys on `disableLigatures` and builds
+    /// its `CTLine` with the same attribute when the flag is set.
+    ///
+    /// Changing this property flushes the attribute and shaper caches so the next
+    /// paint picks up the new setting without a font reset.
+    ///
+    /// Default `false` — ligatures are on, matching the behaviour of every
+    /// terminal that does not explicitly suppress them.
+    @objc open var disableLigatures: Bool {
+        get { _disableLigatures }
+        set {
+            guard _disableLigatures != newValue else { return }
+            _disableLigatures = newValue
+            // Flush the per-attribute-combo cache so `getAttributes` rebuilds
+            // every entry with the new ligature flag on the next paint.
+            // `resetFont()` would also flush, but it re-measures the font,
+            // resizes the terminal, and triggers `processSizeChange` — far more
+            // than we need. `resetCaches()` is the minimal, correct operation.
+            resetCaches()
+        }
+    }
+
